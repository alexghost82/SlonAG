# ============================================================
# SlonAG — Environment variables (copy to .env and fill in)
# ============================================================
# NEVER commit real secrets. This file contains placeholders only.

# --- Google GenAI API key (Gemini) ---
# Obtain from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here

# --- Optional: OpenAI (if used) ---
# OPENAI_API_KEY=your-api-key-here

# --- Optional: Azure / other providers ---
# AZURE_API_KEY=your-api-key-here
# AZURE_ENDPOINT=https://your-resource.openai.azure.com

# --- Server / gateway ---
# SLON_HOST=127.0.0.1
# SLON_PORT=8000

# --- Logging ---
# LOG_LEVEL=INFO

# --- Memory ---
# MEMORY_DIR=./memory

# --- Localization ---
# LOCALE=en
